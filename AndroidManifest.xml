<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.indexintegrated.indextloader"
    android:versionCode="1"
    android:versionName="2026.0.0">

    <uses-sdk
        android:minSdkVersion="9"
        android:targetSdkVersion="19" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="InDEXt Loader"
        android:theme="@style/AppThemeDark">

        <activity
            android:name=".MainActivity"
            android:label="InDEXt Loader"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ModelSettingsActivity"
            android:label="Model Settings"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".AppSettingsActivity"
            android:label="App Settings"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".GuideActivity"
            android:label="User Guide"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".AboutActivity"
            android:label="About App"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".FilePickerActivity"
            android:label="Select File"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ChatActivity"
            android:label="InDEXt Loader"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize" />
    </application>
</manifest>
